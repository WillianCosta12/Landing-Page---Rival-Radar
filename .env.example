# ─────────────────────────────────────────────────────
# URL do site — preencha após o primeiro deploy na Vercel
# Exemplo: https://landing-page-rival-radar.vercel.app
# ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://landing-page-rival-radar.vercel.app

# Supabase — pegue em https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# Resend — pegue em https://resend.com/api-keys
RESEND_API_KEY=re_sua_api_key_aqui

# E-mail que receberá notificações de novos leads
NOTIFICATION_EMAIL=seu@email.com

# Slack Incoming Webhook (opcional)
# Como criar: https://api.slack.com/apps → Incoming Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/SEU/WEBHOOK/AQUI

# Admin dashboard — acesse em /admin com Basic Auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD=senha_forte_aqui

# Plausible Analytics (opcional — analytics sem cookies)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=landing-page-rival-radar.vercel.app
